            "Anchored": true,
            "CanCollide": true,
            "Color": [1.0, 0.8, 0.6],
            "Position": [-100, 1, 100],
            "Size": [40, 2, 40]
          }
        },
        "Plot4": {
          "$className": "Part",
          "$properties": {
            "Anchored": true,
            "CanCollide": true,
            "Color": [1.0, 0.6, 0.8],
            "Position": [100, 1, 100],
            "Size": [40, 2, 40]
          }
        }
      },
      "Zones": {
        "$className": "Folder",
        "Pond": {
          "$className": "Part",
          "$properties": {
            "Anchored": true,
            "CanCollide": true,
            "Color": [0.2, 0.6, 0.9],
            "Position": [0, 1, 0],
            "Size": [120, 4, 120]
